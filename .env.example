# ── LM Studio (local, OpenAI-compatible) ──────────────────────────────
# Start the LM Studio local server, then copy the model identifier that
# GET http://localhost:1234/v1/models returns into LM_STUDIO_MODEL.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen3-8b
LM_STUDIO_API_KEY=lm-studio

# ── Database (SQLite via Prisma) ──────────────────────────────────────
DATABASE_URL="postgresql://intentguard_user:f37gZxIfuKA07tByqKC63QJVa3v6QexJ@dpg-db0l176gekts73a5ruhg-a.singapore-postgres.render.com/intentguard"

# ── Risk alerts (Web Push, optional) ──────────────────────────────────
# Leave empty and IntentGuard generates a key pair on first use and stores it in the database.
# To set your own: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Real email (optional) ─────────────────────────────────────────────
# Without these, send_email is simulated. With them, emails the user explicitly
# asked for (and IntentGuard allowed) are really sent. For Gmail, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
